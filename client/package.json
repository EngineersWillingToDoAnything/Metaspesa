{
  "name": "metaspesa_web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "generate-api": "openapi-ts",
    "lint": "prettier --check . && eslint",
    "format": "prettier --write . && eslint --fix .",
    "test": "pnpm test:unit && pnpm test:component",
    "test:unit": "vitest run test/unit",
    "test:component": "vitest run test/component",
    "test:integration": "vitest run test/integration",
    "test:e2e": "playwright test --project=firefox-e2e",
    "test:visual": "playwright test --project=firefox-visual",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "~1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.83.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "0.301.1",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.301.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.301.1",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "next": "^16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
